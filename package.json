{
  "name": "zhiyin-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:service": "vitest run --config vitest.service.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "node scripts/setup.mjs",
    "local": "node scripts/local.mjs",
    "eval": "tsx scripts/eval/run.ts",
    "eval:validate": "tsx scripts/eval/offline.ts validate tests/evaluation/engineering.inputs.json tests/evaluation/engineering.annotations.json",
    "eval:score": "tsx scripts/eval/offline.ts score",
    "eval:demo": "tsx scripts/eval/demo.ts",
    "eval:plan": "tsx scripts/eval/controlled.ts",
    "eval:live": "tsx scripts/eval/controlled.ts --execute",
    "test:faults": "node scripts/m6/run-fault-tests.mjs",
    "test:production": "node scripts/m6/run-production-regression.cjs",
    "security:staged": "node scripts/security-scan-git.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
